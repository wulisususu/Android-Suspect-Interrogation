{
  "name": "suspect-interrogation-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "check": "node --check src/server.mjs && node --check src/db.mjs && node --check src/store.mjs",
    "smoke": "node test/smoke.mjs"
  }
}
