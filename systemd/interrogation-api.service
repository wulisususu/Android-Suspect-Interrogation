[Unit]
Description=Suspect Interrogation Linux API
After=local-fs.target network.target
Wants=network.target

[Service]
Type=simple
User=suspect-interrogation
Group=suspect-interrogation
WorkingDirectory=/opt/suspect-interrogation/current/linux/backend
EnvironmentFile=/etc/suspect-interrogation/runtime.env
ExecStart=/bin/sh -c 'exec /opt/suspect-interrogation/current/.venv/bin/uvicorn app.main:app --host "$SUSPECT_API_HOST" --port "$SUSPECT_API_PORT"'
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/suspect-interrogation /var/log/suspect-interrogation -/run/suspect-interrogation

[Install]
WantedBy=multi-user.target
