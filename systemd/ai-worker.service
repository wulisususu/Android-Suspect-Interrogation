[Unit]
Description=Suspect Interrogation Optional Offline AI Worker
After=local-fs.target
ConditionPathExists=/opt/suspect-interrogation/current/linux/backend

[Service]
Type=simple
User=suspect-interrogation
Group=suspect-interrogation
WorkingDirectory=/opt/suspect-interrogation/current/linux/backend
EnvironmentFile=/etc/suspect-interrogation/runtime.env
EnvironmentFile=-/etc/suspect-interrogation/ai-worker.env
Environment=SUSPECT_SPEECH_SOCKET=/run/suspect-interrogation/speech.sock
# No runtime directory declaration here on purpose: /run/suspect-interrogation
# is shared with moss-worker.service, and systemd GCs the directory whenever a
# declaring unit stops, orphaning the other service's bound socket (this
# removed moss.sock on every redeploy). The directory is created by
# /etc/tmpfiles.d/suspect-interrogation-moss.conf instead.
ExecStart=/opt/suspect-interrogation/current/scripts/ai-worker-start.sh
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/suspect-interrogation /var/lib/suspect-interrogation /var/log/suspect-interrogation
ReadOnlyPaths=/opt/suspect-interrogation/models/funasr /opt/suspect-interrogation/runtime/funasr-env /opt/suspect-interrogation/runtime/xvector-legacy-env

[Install]
WantedBy=multi-user.target
