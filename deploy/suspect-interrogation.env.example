# Production defaults: loopback-only kiosk deployment.
SUSPECT_API_HOST=127.0.0.1
SUSPECT_API_PORT=8000
SUSPECT_DEBUG=false
SUSPECT_CORS_ORIGINS=
SUSPECT_DATA_DIR=/var/lib/suspect-interrogation
SUSPECT_DB_PATH=/var/lib/suspect-interrogation/interrogation.db
SUSPECT_LOG_DIR=/var/log/suspect-interrogation
SUSPECT_MODEL_PATH=/opt/suspect-interrogation/models
SUSPECT_MIN_FREE_MB=256
# LAN exposure is opt-in; configure an explicit host and explicit CORS origins.
