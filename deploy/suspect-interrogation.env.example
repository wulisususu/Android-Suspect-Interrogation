# Production defaults: loopback-only kiosk deployment.
SUSPECT_API_HOST=127.0.0.1
SUSPECT_API_PORT=8000
SUSPECT_DEBUG=false
SUSPECT_CORS_ORIGINS=
SUSPECT_DATA_DIR=/var/lib/suspect-interrogation
SUSPECT_DB_PATH=/var/lib/suspect-interrogation/interrogation.db
SUSPECT_LOG_DIR=/var/log/suspect-interrogation
SUSPECT_MODEL_PATH=/opt/suspect-interrogation/models
SUSPECT_WEB_DIST_DIR=/opt/suspect-interrogation/current/webapp/dist
SUSPECT_MIN_FREE_MB=256
SUSPECT_SPEECH_SOCKET=/run/suspect-interrogation/speech.sock
SUSPECT_FUNASR_MODEL_ROOT=/opt/suspect-interrogation/models/funasr
SUSPECT_FUNASR_PYTHON=/opt/suspect-interrogation/runtime/funasr-env/bin/python
# Voiceprint speaker calibration is intentionally unset by default.
# After Task 12 calibration on the target RK3588 + production microphone/environment,
# set BOTH keys together in /etc/suspect-interrogation/ai-worker.env:
# SUSPECT_SPEAKER_ACCEPT_THRESHOLD=<calibrated decimal 0..1>
# SUSPECT_SPEAKER_MARGIN=<calibrated decimal 0..1>
# Both interrogation-api.service and ai-worker.service read ai-worker.env; missing or
# invalid calibration keeps speaker verification fail-closed instead of guessing.
# LAN exposure is opt-in; configure an explicit host and explicit CORS origins.
